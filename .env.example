DATABASE_URL=postgresql://paysentry:paysentry@localhost:5432/paysentry
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=20
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=5
RATE_LIMIT_FAIL_OPEN=true
ADMIN_API_KEY=dev-admin-key
GATEWAYS={"alpha": {"flavour": "alpha", "url": "http://localhost:9001"}, "beta": {"flavour": "beta", "url": "http://localhost:9002"}}
ROUTING_STRATEGY=success_rate
ROUTING_WINDOW=100
ROUTING_MAX_ATTEMPTS=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SEC=30
GATEWAY_TIMEOUT_SEC=2
RECOVERY_AFTER_SEC=60
RECOVERY_INTERVAL_SEC=10
